# Copy to .env and fill in. Committed as documentation; .env stays gitignored.

# Admin login — Supabase Auth (lib/auth.ts). Fixed email for the single admin
# user; create it (confirmed) in Supabase ▸ Authentication ▸ Users.
ADMIN_EMAIL=admin@example.com

# ── Supabase (lib/supabase/*) ──
# Public values — Supabase dashboard ▸ Settings ▸ API. Inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — keep out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
